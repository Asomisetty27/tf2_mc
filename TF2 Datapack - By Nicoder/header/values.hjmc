#define Gamemode.VIP_RACE 14
#define Gamemode.OTHER 15

#define BASE_SPEED 0.132

#enum Class 1 SPY SNIPER SCOUT SOLDIER DEMOMAN HEAVY PYRO ENGINEER MEDIC CIVILIAN

#enum Reload NONE SINGLE LOSSY LOSSLESS

#enum Door OPEN CLOSED RED_PROXIMITY BLU_PROXIMITY ALL_PROXIMITY
#define Math.T 15
#define Math.D 3
#define Math.F 0.1

#define Projectile.SPECIAL_PROPERTIES ["explosion", "has_trail", "unreflectable", "animated", "can_destroy_stickybombs"]
