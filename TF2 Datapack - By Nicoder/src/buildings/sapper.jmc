// The Spy's Sapper, following CObjectSapper and CTFWeaponBuilder in Valve's source-sdk-2013:
//   attaches to an enemy building within 160 HU (tf_obj_max_attach_dist); sapping one teleporter also saps its partner
//   the sapped building is disabled and loses 25 HP per second (obj_sapper_amount), credited to the Spy
//   the sapper has 100 HP; only wrench hits hurt it, 65 each (WRENCH_DMG_VS_SAPPER), so two hits remove it
//   a wrench hit on a teleporter's sapper also hits the sapper on the other end
//   after a sapper comes off, the building stays disabled for another 0.5 s (SAPPER_REMOVE_DISABLE_TIME)
// There is no separate sapper entity: its state lives on the building, so it dies with the building.

class building.sapper {
    function place() {
        // @s = Spy holding the Sapper, called from Weapons.main_fire()
        if (tf2.is_invisible:@s == 1) {
            return fail;
        }
        tag @s add tf2.sapping;
        vars::iris_target_entities = iris:settings::TargetEntities;
        vars::iris_depth = iris:settings::MaxRecursionDepth;
        tf2.team:$spy_team = tf2.team:@s;
        $spy_id = tf2.player.id:@s;

        // aim at the building, like placing it in TF2
        iris:settings::TargetEntities = true;
        execute anchored eyes positioned ^ ^ ^ run Raycast.informational();
        execute as @e[type=item_display, tag=iris.targeted_entity, tag=tf2.base] on passengers run tag @s add iris.targeted_entity;
        execute as @e[type=item_display, tag=iris.targeted_entity, predicate=tf2:is_a_building, distance=..3.05]
                unless score @s tf2.team = $spy_team tf2.team
                run tag @s add tf2.sap_target;
        tag @e[tag=tf2.sap_target, tag=tf2.sapped] remove tf2.sap_target;
        tag @e remove iris.targeted_entity;

        // otherwise snap to the nearest enemy building in range, in front, and in sight (FindSnapToBuildPos)
        if (!entity @e[tag=tf2.sap_target]) {
            execute anchored eyes positioned ^ ^ ^1.5
                    as @e[type=item_display, predicate=tf2:is_a_building, tag=!tf2.sapped, distance=..1.8]
                    unless score @s tf2.team = $spy_team tf2.team
                    run tag @s add tf2.sap_candidate;
            tag @e[tag=tf2.sap_candidate, distance=3.05..] remove tf2.sap_candidate;
            execute as @e[tag=tf2.sap_candidate, sort=nearest] run this.try_snap();
            tag @e remove tf2.sap_candidate;
        }

        tag @s remove tf2.sapping;
        iris:settings::TargetEntities = vars::iris_target_entities;
        iris:settings::MaxRecursionDepth = vars::iris_depth;
        if (!entity @e[tag=tf2.sap_target]) {
            return run playsound minecraft:block.dispenser.fail player @s ~ ~ ~ 0.5 1.6;
        }
        execute as @e[tag=tf2.sap_target, limit=1] at @s run this.attach();
        tag @e remove tf2.sap_target;
        return 1;
    }

    function try_snap() {
        // @s = candidate building, the Spy is @e[type=#tf2:player_like, tag=tf2.sapping, limit=1]. Keeps the first one with a clear line of sight.
        if (entity @e[tag=tf2.sap_target]) {
            return 0;
        }
        tag @s add tf2.sap_checking;
        iris:settings::TargetEntities = false;
        iris:settings::MaxRecursionDepth = 4;
        execute as @e[type=#tf2:player_like, tag=tf2.sapping, limit=1] at @s anchored eyes positioned ^ ^ ^
                facing entity @e[tag=tf2.sap_checking, limit=1] feet
                run function iris:get_target;
        $blocked = false;
        execute if data storage iris:output {TargetType: "BLOCK"} run this.compare_wall_distance() with iris:output::;
        execute unless score $blocked tf2.var matches 1.. run tag @s add tf2.sap_target;
        tag @s remove tf2.sap_checking;
    }

    function compare_wall_distance() {
        // @needs_macro: blocked if the wall the ray hit is nearer than the building
        $execute as @e[type=#tf2:player_like, tag=tf2.sapping, limit=1] at @s anchored eyes positioned ^ ^ ^
                 unless entity @e[tag=tf2.sap_checking, distance=..$(Distance)]
                 run scoreboard players set $blocked tf2.var 1;
    }

    function attach() {
        // @s = enemy building being sapped
        this.attach_one();
        execute if entity @s[tag=tf2.teleporter] run {
            building.teleporter.tag_match();
            execute as @e[tag=tf2.tele_match, tag=!tf2.sapped] at @s run building.sapper.attach_one();
            tag @e remove tf2.tele_match;
        }
    }

    function attach_one() {
        tag @s add tf2.sapped;
        tf2.building.sapper_hp:@s = 100;
        tf2.building.sapper_owner:@s = $spy_id;
        tf2.building.target:@s[tag=tf2.sentry].reset();
        playsound minecraft:block.redstone_torch.burnout block @a ~ ~ ~ 0.8 0.7;
        particle minecraft:electric_spark ~ ~0.3 ~ 0.3 0.3 0.3 0.1 15;

        building.sentry.get_owner();
        execute if entity @s[tag=tf2.sentry] run Text.tellraw(@a[tag=tf2.owner], "&<red>Your Sentry Gun is being sapped!");
        execute if entity @s[tag=tf2.dispenser] run Text.tellraw(@a[tag=tf2.owner], "&<red>Your Dispenser is being sapped!");
        execute if entity @s[tag=tf2.tele_entrance] run Text.tellraw(@a[tag=tf2.owner], "&<red>Your Teleporter Entrance is being sapped!");
        execute if entity @s[tag=tf2.tele_exit] run Text.tellraw(@a[tag=tf2.owner], "&<red>Your Teleporter Exit is being sapped!");
        tag @a remove tf2.owner;
    }

    function disabled() {
        // @s = any building. Runs the sapper while one is attached, and returns true while the building is disabled
        if (entity @s[tag=tf2.sapped]) return run {
            this.drain();
            return 1;
        }
        if (tf2.building.disable_ticks:@s > 0) return run {
            tf2.building.disable_ticks:@s--;
            return 1;
        }
        return 0;
    }

    function drain() {
        // 25 HP per second: 5 HP every 4 ticks, through the damage queue so the Spy gets the kill
        $particle_timer := xrroou1m8_p_join:$__global__ % 5;
        if ($particle_timer == 0) {
            particle minecraft:electric_spark ~ ~0.3 ~ 0.25 0.25 0.25 0.05 3;
        }
        $drain_timer := xrroou1m8_p_join:$__global__ % 4;
        if ($drain_timer != 0) {
            return 0;
        }
        lookup::damages << {kill_verb: "destroyed", weapon: [{text: "Sapper", italic: true, color: "gray"}]};
        lookup::damages[-1].cause = tf2.building.sapper_owner:@s;
        lookup::damages[-1].target = tf2.player.id:@s;
        lookup::damages[-1].amount = 5;
        return 1;
    }

    function wrench_hit() {
        // @s = sapped friendly building. A wrench hit only damages the sapper (InputWrenchHit).
        this.damage_sapper();
        execute if entity @s[tag=tf2.teleporter] run {
            building.teleporter.tag_match();
            execute as @e[tag=tf2.tele_match, tag=tf2.sapped] at @s run building.sapper.damage_sapper();
            tag @e remove tf2.tele_match;
        }
        playsound minecraft:block.anvil.land block @a ~ ~ ~ 0.4 1.8;
    }

    function damage_sapper() {
        tf2.building.sapper_hp:@s -= WRENCH_DMG_VS_SAPPER;
        if (tf2.building.sapper_hp:@s <= 0) {
            this.remove();
        }
    }

    function remove() {
        tag @s remove tf2.sapped;
        tf2.building.sapper_hp:@s = 0;
        tf2.building.sapper_owner:@s.reset();
        tf2.building.disable_ticks:@s = 10;
        particle minecraft:smoke ~ ~0.4 ~ 0.2 0.2 0.2 0.02 8;
        playsound minecraft:entity.item.break block @a ~ ~ ~ 0.7 0.8;
    }
}
